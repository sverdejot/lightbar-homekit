#!/usr/bin/env bash
#MISE description="Flash the firmware over serial DFU (keeps the Matter pairing)"
#USAGE flag "--pkg <file>" help="Flash this DFU package (e.g. from a release) instead of building"
set -euo pipefail
PKG=${usage_pkg:-firmware/build/dfu.zip}
[ -n "${usage_pkg:-}" ] || mise run build
[ -f "$PKG" ] || { echo "$PKG not found" >&2; exit 1; }

product() { ioreg -p IOUSB -l -w0 | grep '"USB Product Name"' | tail -1 | sed 's/.*= "//; s/"$//'; }
port() { ls /dev/cu.usbmodem* 2>/dev/null | head -1; }
wait_product() { for _ in $(seq 30); do product | grep -q "$1" && return 0; sleep 1; done; return 1; }
touch_1200() { python -c "import serial,sys,time; s=serial.Serial(sys.argv[1],1200); time.sleep(0.2); s.close()" "$(port)"; }
shell_cmd() {
  python -c "import serial,sys,time; s=serial.Serial(sys.argv[1],115200); time.sleep(1); s.write(b'\r\n'); time.sleep(0.5); s.write((sys.argv[2]+'\r\n').encode()); time.sleep(1)" \
    "$(port)" "$1" 2>/dev/null || true
}

case "$(product)" in
"Lightbar Matter")
  shell_cmd "lamp dfu"; sleep 3 ;;
"Feather nRF52840 Express")
  touch_1200; sleep 3 ;;
"nice_nano v2")
  mise run dfu-stub:build
  mise run uf2:copy tools/dfu-stub/dfu_stub/build/dfu_stub.uf2
  wait_product Feather || { echo "DFU stub did not boot" >&2; exit 1; }
  sleep 2; touch_1200; sleep 3 ;;
*)
  echo "board not found ('$(product)'). Double-tap RST-GND and retry." >&2; exit 1 ;;
esac

OUT=$(adafruit-nrfutil dfu serial -pkg "$PKG" -p "$(port)" -b 115200 --singlebank 2>&1 || true)
echo "$OUT" | grep -q "Device programmed" || { echo "$OUT" | tail -3; echo "DFU failed" >&2; exit 1; }
sleep 3
wait_product "Lightbar Matter" && echo "flashed, running: $(product)"
